@using TicketBox.Application.Features.Events.Results
@model List<GetEventsQueryResult>
@{
    ViewData["Title"] = "Event Management";
    ViewData["Subtitle"] = "Add, edit or remove events";
    ViewData["ActiveNav"] = "Events";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="panel">
    <div class="flex-between mb-16">
        <span class="muted" style="font-size:14px;">@Model.Count events</span>
        <a class="btn btn-primary btn-sm" href="/Admin/Event/CreateEvent">+ Add Event</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state"><div class="ic">🎫</div>No events yet. Add your first event to get started.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Event</th><th>Category</th><th>Date</th><th>Price</th><th>Seats</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr class="row-hover">
                            <td>
                                <div class="flex-gap">
                                    <img src="@ev.ImageUrl" class="thumb-sm" alt="@ev.Title">
                                    <div>
                                        <div class="td-title">@ev.Title</div>
                                        <div class="td-sub">@ev.Location</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-violet">@ev.CategoryName</span></td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy") @ev.EventDate.ToString("HH:mm")</td>
                            <td>₺@ev.Price.ToString("N0")</td>
                            <td>@ev.SoldTickets / @ev.Capacity.ToString("N0")</td>
                            <td style="text-align:right; white-space:nowrap;">
                                <a class="btn btn-secondary btn-sm" href="/Admin/Event/UpdateEvent/@ev.EventId">Edit</a>
                                <a class="btn btn-danger btn-sm" href="/Admin/Event/DeleteEvent/@ev.EventId">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

