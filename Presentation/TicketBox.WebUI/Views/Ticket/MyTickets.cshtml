@using TicketBox.Application.Features.Tickets.Results
@model List<GetMyTicketQueryResult>
@{
    ViewData["Title"] = "MyTickets";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewData["ActiveNav"] = "MyTickets";
}

<section class="section">
    <div class="container">
        <span class="eyebrow">WALLET</span>
        <h1 class="mt-16 mb-24" style="font-size:32px;">My Tickets</h1>

        @if (Model.Count == 0)
        {
            <div class="empty-state"><div class="ic">🎟️</div>No tickets yet. Book an event to see it here.</div>
        }
        else
        {
            <div class="grid-events">
                @foreach (var t in Model)
                {
                        <a class="event-card" href="/Ticket/Details/@t.TicketId">
                            <div class="thumb">
                                <img src="@t.EventImageUrl" alt="@t.EventName">
                                <span class="badge badge-violet cat-badge">@t.CategoryName</span>
                                <span class="price-badge">@t.Status</span>
                            </div>
                            <div class="body">
                                <h3>@t.EventName</h3>
                                <div class="meta-row">📅 @t.EventDate.ToString("dd MMM yyyy") &nbsp;·&nbsp; 🕐 @t.EventDate.ToString("HH:mm")</div>
                                <div class="meta-row">📍 @t.EventLocation</div>
                            </div>
                            <div class="stub">
                                <span class="mono muted" style="font-size:12px;">@t.SerialNumber</span>
                                <span class="btn btn-primary btn-sm">View Ticket</span>
                            </div>
                        </a>
                    }
            </div>
        }
    </div>
</section>


