@using TicketBox.Application.Features.Events.Results
@model List<EventCardQueryResult>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="section-head"><h2>Upcoming This Month</h2></div>
        <div class="grid-events">
            @if (!Model.Any())
            {
                <span class="muted" style="font-size:14px;">
                    There are no events this month
                </span>
            }
            else
            {
                foreach (var item in Model)
                {
                    <a class="event-card" href="/Event/Details/@item.EventId">
                        <div class="thumb">
                            <img src="@item.ImageUrl" alt="@item.Title" loading="lazy">
                            <span class="badge badge-violet cat-badge">@item.CategoryIcon @item.CategoryName</span>
                            <span class="price-badge">₺@item.Price.ToString("N0")</span>
                        </div>
                        <div class="body">
                            <h3>@item.Title</h3>
                            <div class="meta-row">
                                📅 @item.EventDate.ToString("dd MMM yyyy") &nbsp;·&nbsp;
                                🕐 @item.EventDate.ToString("HH:mm")
                            </div>
                            <div class="meta-row">📍 @item.Location</div>
                        </div>
                        <div class="stub">
                            <span class="mono muted" style="font-size:12px;">@item.RemainingTickets seats left</span>
                            <span class="btn btn-primary btn-sm">View Details</span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</section>