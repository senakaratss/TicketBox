@using TicketBox.Application.Features.Events.Results
@model GetEventSeatsQueryResult
@{
    ViewData["Title"] = "SelectSeats";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
@{
    var rows = new[] { "A", "B", "C", "D" };
    var seatsPerRows = 8;
}
<section class="section">
    <div class="container" style="max-width:820px;">
        <span class="eyebrow">STEP 1 OF 2</span>
        <h1 class="mt-16 mb-8" style="font-size:32px;">Choose your seats</h1>
        <p class="muted mb-24">@Model.EventName · @Model.Location · @Model.EventDate.ToString("dd MMM yyyy"), @Model.EventDate.ToString("HH:mm")</p>

        <div class="panel">
            <div class="screen">
                <div class="screen-bar"></div>
                <span>Stage</span>
            </div>

            <div class="seat-map mb-24">
                @foreach (var row in rows)
                {
                    <div class="seat-row">
                        <span class="seat-row-label">@row</span>
                        @for (int i = 1; i <= seatsPerRows; i++)
                        {
                            var seatNumber = $"{row}{i}";
                            var isTaken = Model.TakenSeats.Contains(seatNumber);
                            if (i == 5)
                            {
                                <span class="seat-aisle"></span>
                            }
                            <input type="checkbox" id="@seatNumber" class="seat-input" disabled="@isTaken">

                            <label for="@seatNumber" class="seat @(isTaken ? "taken" : "")">@seatNumber</label>

                        }
                    </div>
                }
            </div>

            <div class="seat-legend mb-24">
                <div class="seat-legend-item"><span class="seat-legend-swatch" style="background:var(--surface-2); border-color:var(--border-strong);"></span> Available</div>
                <div class="seat-legend-item"><span class="seat-legend-swatch" style="background:var(--violet); border-color:var(--violet);"></span> Selected</div>
                <div class="seat-legend-item"><span class="seat-legend-swatch" style="background:var(--surface-3); border-color:var(--border); opacity:.6;"></span> Taken</div>
            </div>

            <hr class="dashed">

            <div class="flex-between" style="flex-wrap:wrap; gap:16px;">
                <div>
                    <div class="muted" style="font-size:12.5px;">Selected seats</div>
                    <div id="selectedSeatsText" style="font-weight:700; font-size:16px;">
                        No seats selected
                    </div>
                </div>
                <div style="text-align:right;">
                    <div class="muted" style="font-size:12.5px;">Subtotal</div>
                    <div id="subtotal" style="font-family:var(--font-display); font-size:22px;">
                        ₺0
                    </div>
                </div>
            </div>

            <button type="button" id="continueButton" class="btn btn-amber btn-block mt-24" style="padding:16px; font-size:16px;">
                Continue to Payment →
            </button>
            <p class="muted mt-16" style="font-size:12px; text-align:center;">Seats are held for 10 minutes while you complete checkout.</p>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/seatHub")
        .withAutomaticReconnect()
        .build();

    connection.start()
        .then(() => {
            console.log("SignalR bağlantısı başarılı.");
        })
        .catch(err => {
            console.error("SignalR bağlantı hatası:", err);
        });

        connection.on("SeatSelected",(eventId,seatNumber)=>{
           console.log("Başka kullanıcı koltuk seçti:", eventId, seatNumber);
           if(eventId!==@Model.EventId) return;

           disabledSeat(seatNumber);
        });
        connection.on("SeatAlreadySelected",(eventId,seatNumber)=>{
            if(eventId!==@Model.EventId) return;
            disabledSeat(seatNumber);        
        });
        connection.on("SeatReleased",(eventId,seatNumber)=>{
            if(eventId!==@Model.EventId) return;
            enableSeat(seatNumber);        
        });
    const eventId=@Model.EventId;

    const ticketPrice=@Html.Raw(Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture));

    const seatInputs=document.querySelectorAll(".seat-input");

    const selectedSeatsText = document.getElementById("selectedSeatsText");
    const subtotal = document.getElementById("subtotal");
    const continueButton = document.getElementById("continueButton");


    function updateSelection(){

        const selectedSeats=Array.from(seatInputs).filter(x=>x.checked).map(x=>x.id);

        if (selectedSeats.length === 0) {
            selectedSeatsText.innerHTML = "No seats selected";
        }
        else {
            selectedSeatsText.innerHTML =
                `${selectedSeats.join(", ")}
                <span class="muted" style="font-weight:400; font-size:13px;">(${selectedSeats.length} seats)</span>`;
        }
        const total = selectedSeats.length * ticketPrice;

        subtotal.innerText = `₺${total.toLocaleString("tr-TR")}`;

        continueButton.disabled = selectedSeats.length === 0;
    }
        continueButton.addEventListener("click", function () {

        const selectedSeats = Array.from(seatInputs)
            .filter(x => x.checked)
            .map(x => x.id);

        if (selectedSeats.length === 0) {
            return;
        }

        const seatNumbers = selectedSeats.join(",");

        window.location.href =
            `/Booking/CreateBooking?eventId=${eventId}&seatNumbers=${encodeURIComponent(seatNumbers)}`;
    });

    seatInputs.forEach(input => {

        input.addEventListener("change", async function () {

            const seatNumber=this.id;
            if(this.checked){
                await connection.invoke("SelectSeat",eventId,seatNumber);
            }else{
                await connection.invoke("ReleaseSeat",eventId,seatNumber);
            }

            updateSelection();
        });

    });
    function disabledSeat(seatNumber){

        const seatInput=document.getElementById(seatNumber);
        if(!seatInput) return;

        seatInput.checked=false;
        seatInput.disabled=true;

        const seatLabel=document.querySelector(`label[for="${seatNumber}"]`);
        if(seatLabel){
            seatLabel.classList.add("taken");
        }
      }
    function enableSeat(seatNumber){

        const seatInput=document.getElementById(seatNumber);
        if(!seatInput) return;

        seatInput.checked=false;
        seatInput.disabled=false;

        const seatLabel=document.querySelector(`label[for="${seatNumber}"]`);
        if(seatLabel){
            seatLabel.classList.remove("taken");
        }
      }
      
      updateSelection();

</script>