@using TicketBox.Application.Features.Users.Commands
@model LoginUserCommand
@{
    ViewData["Title"] = "Login";
    ViewData["HideFooter"] = true;
    ViewData["ActiveNav"] = "";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-head">
            <div class="logo" style="justify-content:center; margin-bottom:18px;">
                <div class="logo-mark">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M4 8.2C4 6.98 4.98 6 6.2 6h11.6C18.98 6 20 6.98 20 8.2v1.35a1.2 1.2 0 0 0 0 2.3v1.35c0 1.2-.98 2.2-2.2 2.2H6.2A2.2 2.2 0 0 1 4 13.1v-1.25a1.2 1.2 0 0 0 0-2.3V8.2z" fill="#FFFFFF" fill-opacity="0.96" />
                        <path d="M12 6.4v9.2" stroke="#0A0B10" stroke-width="1.3" stroke-dasharray="1.6 1.8" stroke-linecap="round" />
                    </svg>
                </div>
                TicketBox
            </div>
            <h1>Welcome back</h1>
        </div>

        <div class="panel">
            
                <div asp-validation-summary="ModelOnly" class="badge badge-danger p-4 mb-16"></div>

            <form method="post">

                <div class="field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" class="input" placeholder="Username">
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="input" placeholder="••••••••">
                </div>
                <div class="flex-between mb-16">
                    <label class="checkbox-row">
                        <input name="RememberMe" type="checkbox">
                        Remember me
                    </label>
                    <a href="javascript:void(0)" style="font-size:13px; color:var(--violet);">Forgot password?</a>
                </div>
                <button class="btn btn-primary btn-block" type="submit" style="padding:15px;">Login</button>
            </form>

            <p class="muted mt-24" style="text-align:center; font-size:14px;">
                Don't have an account?
                <a href="/Account/Register" style="color:var(--violet); font-weight:600;">Register</a>
            </p>
        </div>
    </div>
</div>
